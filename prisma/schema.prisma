generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INSTALLER
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  AUDIT_IN_PROGRESS
  INSTALLER_VERIFICATION_NEEDED
  QUOTE_READY
  INVOICE_SENT
  PAID
  MATERIALS_ORDERED
  INSTALLATION_SCHEDULED
  INSTALLED
  MAINTENANCE_FOLLOW_UP
}

enum EquipmentCategory {
  INVERTER
  BATTERY
  SOLAR_PANEL
  CABLE
  BREAKER
  SURGE_PROTECTION
  MOUNTING_KIT
  EARTHING_MATERIAL
  COMBINER_BOX
  ACCESSORY
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
  UNKNOWN
}

enum BudgetLevel {
  BUDGET
  VALUE
  PREMIUM
}

enum SystemCategory {
  BASIC_BACKUP
  MEDIUM_HOME_BACKUP
  FULL_HOME_BACKUP
  SMALL_BUSINESS_BACKUP
  COMMERCIAL_AUDIT_REQUIRED
}

enum SourceType {
  VENDOR_QUOTE
  INSTALLER_FEEDBACK
  MARKET_RESEARCH
  COMPETITOR_PRICING
  WARRANTY_DOCUMENT
  FAILURE_REPORT
  COMPLIANCE_PROOF
  OTHER
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  EXPIRED
}

enum InvoiceStatus {
  PRO_FORMA
  SENT
  PAID
  CANCELLED
}

enum PaymentStructure {
  DEPOSIT_BALANCE
  MILESTONE
  FULL_PAYMENT
}

enum DifficultyRating {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResearchNoteType {
  VENDOR_PRICE_RESEARCH
  INSTALLER_LABOR_COST_RESEARCH
  BEST_INVERTER_BRANDS_BY_BUDGET
  BEST_BATTERY_BRANDS_BY_BUDGET
  BEST_PANEL_BRANDS_BY_BUDGET
  WARRANTY_NOTES
  FAILURE_REPORTS
  MARKET_NOTES
  COMPETITOR_PRICING
  NIGERIAN_SOLAR_MARKET_INSIGHTS
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(ADMIN)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedWorkOrders WorkOrder[]
  verifications      InstallerVerification[]
}

model Lead {
  id                              String       @id @default(cuid())
  name                            String
  phone                           String
  email                           String
  location                        String
  propertyType                    String
  nepaAvailabilityPerDay          Float
  monthlyFuelSpend                Decimal      @db.Decimal(12, 2)
  generatorUse                    String
  backupHoursNeeded               Float
  budgetRange                     String
  urgency                         String
  extraNotes                      String?
  photoUrls                       Json?
  status                          LeadStatus   @default(NEW_LEAD)
  quoteVerificationRequired       Boolean      @default(true)
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt

  appliances       ApplianceLoad[]
  loadAudits       LoadAudit[]
  siteInspections  SiteInspection[]
  photoReviews     PhotoReview[]
  verifications    InstallerVerification[]
  quotes           Quote[]
  invoices         Invoice[]
  workOrders       WorkOrder[]
  maintenance      MaintenanceRecord[]
  notes            Note[]
  activityLogs     ActivityLog[]

  @@index([status])
  @@index([createdAt])
}

model ApplianceLoad {
  id          String   @id @default(cuid())
  leadId      String
  name        String
  quantity    Int
  wattage     Float
  hoursPerDay Float
  category    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LoadAudit {
  id                         String         @id @default(cuid())
  leadId                     String
  totalRunningWatts          Float
  dailyEnergyWh              Float
  dailyEnergyKwh             Float
  backupEnergyWh             Float
  suggestedInverterWatts     Float
  suggestedBatteryWh         Float
  suggestedSolarArrayWatts   Float
  systemCategory             SystemCategory
  warningFlags               Json
  manualOverride             Boolean        @default(false)
  overrideNotes              String?
  calculationSnapshot        Json
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model SiteInspection {
  id                     String   @id @default(cuid())
  leadId                 String
  roofCondition          String?
  roofSpaceNotes         String?
  wiringCondition        String?
  shadingNotes           String?
  inverterLocationNotes  String?
  batteryLocationNotes   String?
  earthingNotes          String?
  safetyRisks            String?
  installerRequired      Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model PhotoReview {
  id                        String           @id @default(cuid())
  leadId                    String
  roofCondition             String?
  shadingRisk               String?
  wiringRisk                String?
  batteryLocationRisk       String?
  inverterVentilationRisk   String?
  installationDifficulty    DifficultyRating?
  additionalPhotoNotes      String?
  aiAnalysisPlaceholder     Json?
  humanReviewRequired       Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model InstallerVerification {
  id                          String            @id @default(cuid())
  leadId                      String
  installerUserId             String?
  actualLoadVerified          Boolean           @default(false)
  wiringConditionChecked      Boolean           @default(false)
  roofSpaceChecked            Boolean           @default(false)
  shadingChecked              Boolean           @default(false)
  inverterLocationChecked     Boolean           @default(false)
  batteryLocationChecked      Boolean           @default(false)
  earthingConditionChecked    Boolean           @default(false)
  safetyRisksNoted            String?
  installationDifficultyRated DifficultyRating?
  finalTechnicalComments      String?
  completedAt                 DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  installer User? @relation(fields: [installerUserId], references: [id])
}

model Vendor {
  id             String   @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  location       String?
  trustScore     Int      @default(50)
  deliveryNotes  String?
  paymentTerms   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  equipmentItems EquipmentItem[]
  prices         VendorPrice[]
}

model EquipmentItem {
  id                         String            @id @default(cuid())
  brand                      String
  model                      String
  category                   EquipmentCategory
  capacity                   String
  price                      Decimal           @db.Decimal(12, 2)
  vendorId                   String?
  warranty                   String
  stockStatus                StockStatus       @default(UNKNOWN)
  compatibilityNotes         String?
  budgetLevel                BudgetLevel       @default(VALUE)
  reliabilityScore           Int               @default(50)
  localSupportScore          Int               @default(50)
  installerFeedbackScore     Int               @default(50)
  vendorTrustScore           Int               @default(50)
  finalRecommendationScore   Int               @default(50)
  adminScore                 Int               @default(50)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  vendor     Vendor?     @relation(fields: [vendorId], references: [id])
  quoteLines QuoteLine[]

  @@index([category, budgetLevel, stockStatus])
}

model SourceRegister {
  id              String          @id @default(cuid())
  sourceType      SourceType
  sourceLink      String?
  dateCollected   DateTime
  expiryDate      DateTime?
  confidenceLevel ConfidenceLevel @default(MEDIUM)
  reviewer        String?
  notes           String?
  proofUrl        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model VendorPrice {
  id               String            @id @default(cuid())
  vendorId         String?
  vendorName       String
  equipmentType    EquipmentCategory
  brand            String
  model            String
  capacity         String
  price            Decimal           @db.Decimal(12, 2)
  stockStatus      StockStatus       @default(UNKNOWN)
  warranty         String?
  deliveryTimeline String?
  proofUploadUrl   String?
  validUntil       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([equipmentType, brand, model, validUntil])
}

model ResearchNote {
  id        String           @id @default(cuid())
  type      ResearchNoteType
  title     String
  content   String
  sourceId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Quote {
  id                            String           @id @default(cuid())
  leadId                        String
  quoteNumber                   String           @unique
  status                        QuoteStatus      @default(DRAFT)
  systemRecommendation          String
  equipmentCost                 Decimal          @db.Decimal(12, 2)
  installationLabor             Decimal          @db.Decimal(12, 2)
  transport                     Decimal          @db.Decimal(12, 2)
  siteInspectionFee             Decimal          @db.Decimal(12, 2)
  altaraManagementFee           Decimal          @db.Decimal(12, 2)
  profitMargin                  Decimal          @db.Decimal(12, 2)
  optionalMaintenanceFee        Decimal          @db.Decimal(12, 2)
  discount                      Decimal          @db.Decimal(12, 2)
  vatTax                        Decimal          @db.Decimal(12, 2)
  totalPrice                    Decimal          @db.Decimal(12, 2)
  paymentStructure              PaymentStructure @default(DEPOSIT_BALANCE)
  depositAmount                 Decimal          @db.Decimal(12, 2)
  balanceAmount                 Decimal          @db.Decimal(12, 2)
  milestoneNotes                String?
  adminApproved                 Boolean          @default(false)
  installerVerificationRequired Boolean          @default(true)
  approvalNotes                 String?
  expiresAt                     DateTime?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lines      QuoteLine[]
  invoices   Invoice[]
  workOrders WorkOrder[]
}

model QuoteLine {
  id              String   @id @default(cuid())
  quoteId         String
  equipmentItemId String?
  description     String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
  isLabor         Boolean  @default(false)
  createdAt       DateTime @default(now())

  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem? @relation(fields: [equipmentItemId], references: [id])
}

model Invoice {
  id             String        @id @default(cuid())
  leadId         String
  quoteId        String
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(PRO_FORMA)
  invoiceDate    DateTime      @default(now())
  expiryDate     DateTime
  totalAmount    Decimal       @db.Decimal(12, 2)
  paymentTerms   String
  warrantyNotes  String?
  disclaimer     String        @default("Final installation is subject to site verification, equipment availability, and technical approval.")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id                   String    @id @default(cuid())
  leadId               String
  quoteId              String?
  assignedInstallerId  String?
  scope                String
  applianceLoadSummary String?
  installationNotes    String?
  assignedTimeline     String?
  status               String    @default("Open")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  lead              Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quote             Quote? @relation(fields: [quoteId], references: [id])
  assignedInstaller User?  @relation(fields: [assignedInstallerId], references: [id])
}

model MaintenanceRecord {
  id           String    @id @default(cuid())
  leadId       String
  scheduledFor DateTime?
  type         String
  status       String    @default("Pending")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  author    String
  body      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String
  actor     String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}
